# Copier ce fichier en .env.local puis renseigner les valeurs réelles.
# .env.local n'est jamais commité (voir .gitignore : `.env*`).

# Clé API Brevo — SERVER-ONLY. Ne jamais préfixer par NEXT_PUBLIC_.
BREVO_API_KEY=

# Adresse et nom expéditeur du rapport de playtest.
REPORT_FROM_EMAIL=
REPORT_FROM_NAME=THE LAW Playtest

# Destinataire du rapport de playtest.
REPORT_TO_EMAIL=contact@ryadsaka.com
